# Copia questo file in ".env" e inserisci i tuoi valori. Non condividere mai il file .env.
TELEGRAM_TOKEN=inserisci_qui_il_nuovo_token_da_BotFather
TELEGRAM_CHAT_ID=inserisci_qui_il_tuo_chat_id

# live_bot.py - conto DEMO IG (chiave API da My IG > Impostazioni > API, con il conto demo selezionato)
# Usa le credenziali dell'ambiente DEMO, mai quelle del conto reale.
IG_API_KEY=inserisci_qui_la_chiave_api_ig_demo
IG_USERNAME=inserisci_qui_il_nome_utente_demo
IG_PASSWORD=inserisci_qui_la_password_demo
IG_ACCOUNT_ID=numero_del_conto_demo_CFD

# live_bot.py - valutazione delle notizie con Claude (console.anthropic.com)
ANTHROPIC_API_KEY=inserisci_qui_la_chiave_anthropic
